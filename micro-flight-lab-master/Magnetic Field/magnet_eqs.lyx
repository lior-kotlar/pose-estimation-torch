\begin_layout Section*
Formulas:
\end_layout

\begin_layout Standard
Coil inductance (approximate):
\begin_inset Formula 
\[
L_{c}\approx N_{turns}^{2}ringRadius\cdot\mu_{0}\left(\log\left(8\frac{ringRadius}{wireRadius}\right)-2\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Coil resistance:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
R=\frac{\rho L}{A}=\frac{2\rho N_{turns}\cdot ringRadius}{wireRadius^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
Ring magnetic field in center:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
B_{RingCenter}=\frac{\mu_{0}I_{tot}}{2\cdot ringRadius}
\]

\end_inset


\end_layout

\begin_layout Standard
Total desired Current:
\begin_inset Formula 
\[
I_{tot}=\frac{2\cdot ringRadius\cdot B_{Desired}}{\mu_{0}}
\]

\end_inset


\end_layout

\begin_layout Standard
Voltage:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{out}=I_{out}R=\frac{2I_{tot}\rho\cdot ringRadius}{wireRadius^{2}}=2\frac{I_{out}\rho N_{turns}\cdot ringRadius}{wireRadius^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
Power:
\begin_inset Formula 
\begin{align*}
P & =I_{channel}^{2}\times R_{tot}=\left(\frac{I_{tot}}{N_{turns}}\right)^{2}\left(R_{coil}+R_{ext}\right)=\left(\frac{I_{tot}}{N_{turns}}\right)^{2}\left(R_{coil}+\frac{L_{c}}{\tau}-R_{coil}\right)\approx\\
 & \approx\left(\frac{2\cdot ringRadius\cdot B_{Desired}}{\mu_{0}}\right)^{2}\frac{ringRadius\cdot\mu_{0}\left(\log\left(8\frac{ringRadius}{wireRadius}\right)-2\right)}{\tau}\propto\frac{B_{Desired}^{2}\cdot ringRadius^{3}}{\tau}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Magnetic field torque:
\begin_inset Formula 
\[
N=\frac{dL}{dt}=I\dot{\omega}=m\times B
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
L=I\omega
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
m=\frac{1}{\mu_{0}}B_{r}V
\]

\end_inset


\end_layout

\begin_layout Subsection*
RL Circuit:
\end_layout

\begin_layout Standard
DC response:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
I_{L}\left(t\right)=\frac{V}{R}\cdot\left(1-e^{-\frac{t}{\tau}}\right)
\]

\end_inset


\begin_inset Formula 
\[
\tau=\frac{L}{R}
\]

\end_inset


\end_layout

\begin_layout Standard
AC response:
\begin_inset Formula 
\[
I_{L}\left(t\right)=\frac{V}{L\sqrt{\left(\frac{R}{L}\right)^{2}+\omega^{2}}}\cdot\left(\frac{\omega}{\sqrt{\left(\frac{R}{L}\right)^{2}+\omega^{2}}}e^{-\frac{t}{\tau}}+\sin\left(\omega t-\arctan\left(\omega\tau\right)\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\omega=2\pi\cdot200\left[Hz\right]=1256
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{R}{L}=335
\]

\end_inset


\end_layout

\begin_layout Subsection*
RLC Circuit:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\omega_{0}=\frac{1}{\sqrt{LC}}
\]

\end_inset


\begin_inset Formula 
\[
C_{Desired}=\frac{1}{L\omega_{in}^{2}}=\frac{1}{L\left(2\pi f_{in}\right)^{2}}\underbrace{=}_{\mathclap{\text{f=200Hz}}}1\times10^{-4}\left[F\right]
\]

\end_inset


\end_layout

\begin_layout Standard
Admittance:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\left|Y\left(i\omega\right)\right|=\frac{1}{\sqrt{R^{2}+\left(L\omega\left(1-\left(\frac{\omega_{0}}{\omega}\right)^{2}\right)\right)^{2}}}
\]

\end_inset


\end_layout

